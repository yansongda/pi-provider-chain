{
  "name": "pi-provider-chain",
  "version": "0.2.0",
  "description": "Pi 扩展：虚拟模型 + 链路（chain）路由 + 额度耗尽自动降级（quota / subscription / overdue 类错误自动切到后备链路）",
  "type": "module",
  "license": "MIT",
  "author": "yansongda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yansongda/pi-provider-chain.git"
  },
  "homepage": "https://github.com/yansongda/pi-provider-chain#readme",
  "bugs": {
    "url": "https://github.com/yansongda/pi-provider-chain/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "virtual-model",
    "provider-chain",
    "model-chain",
    "quota",
    "router"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "extensions",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/provider-chain.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "test": "bun test",
    "test:node": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck",
    "pack": "bun pm pack --dry-run"
  }
}
